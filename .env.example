# ---------------------------------------------------------------------------
# Car Rental Management System - environment variables
#
# There are two sides, and the split matters for security.
#
#   SERVER  -> read inside the Vercel functions in /api. Never reaches a
#              browser. These have no `VITE_` prefix and that is deliberate:
#              Vite inlines anything prefixed `VITE_` into the JS bundle.
#   CLIENT  -> prefixed `VITE_`, inlined into the bundle, public by nature.
#              Only non-sensitive switches belong here.
# ---------------------------------------------------------------------------

## ============================================================ SERVER (Vercel)

# Neon pooled connection string. Server-only: this is the value that must never
# be given a VITE_ prefix, or it becomes a public download.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Signs the session cookie. Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this signs everyone out.
# `SESSION_SECRET` is accepted as a fallback for the same value, so either name
# works if you already have one set from a previous deployment.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-the-same-long-random-string

# Optional. Session lifetime. Accepts seconds (`43200`) or a suffixed duration
# (`30m`, `12h`, `7d`, `2w`). Anything unreadable falls back to 12h, so a typo
# never locks everyone out. The cookie and the token's own expiry both follow it.
JWT_EXPIRES_IN=12h

# Optional. When false in production, /api strips password-reset tokens from
# responses instead of showing the reset link on screen. Defaults to on outside
# production so local setup still works without a mail server.
EXPOSE_RESET_TOKEN=false

## ========================================================== CLIENT (Vite)

# Production builds always use the live API. Set this to "mock" only for local
# development when you intentionally want browser-only sample data.
VITE_DATA_SOURCE=api

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# For `vercel dev` or a local API handler, export the server values as real
# environment variables before starting, e.g.
#
#   $env:DATABASE_URL="postgresql://..."
#   $env:SESSION_SECRET="..."
#   npm run dev:api
#
# Do not add a VITE_NEON_DATABASE_URL. That name is what caused the original
# leak: it published the database owner password to every visitor.