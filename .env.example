# ---------------------------------------------------------------------------
# Car Rental Management System - environment variables
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Neon Postgres pooled connection string (Project Settings -> Connect).
# LOCAL TESTING ONLY: VITE_ variables are bundled into browser JavaScript.
# Never use a production database credential here or expose it in a public deployment.
VITE_NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
VITE_SESSION_SECRET=change-me-to-a-long-random-string

# "mock"  -> browser-local data (no database required, current state)
# "neon"  -> read/write through Neon Postgres
VITE_DATA_SOURCE=mock