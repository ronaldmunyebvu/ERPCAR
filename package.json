{
  "name": "carrental-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "Car Rental Management System - multi-tenant ERP for car hire companies",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-stamp.mjs && vite build",
    "build:stamp": "node scripts/build-stamp.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "db:setup": "node scripts/neon-setup.mjs",
    "db:setup:force": "node scripts/neon-setup.mjs --force --seed-demo",
    "db:seed-demo": "node scripts/neon-setup.mjs --seed-demo",
    "db:schema": "node scripts/neon-setup.mjs --schema-only",
    "db:check": "node scripts/neon-check.mjs",
    "api:check": "node --env-file=.env scripts/api-check.mjs",
    "db:cleanup": "node --env-file=.env scripts/db-cleanup.mjs",
    "api:http": "node --env-file=.env scripts/http-check.mjs",
    "verify": "npm run api:check && npm run api:http && npm run lint && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "lucide-react": "^0.511.0",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tailwindcss/vite": "^4.1.7",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.1.0",
    "tailwindcss": "^4.1.7",
    "vite": "^6.3.5"
  }
}
